# Copy to .env (gitignored) and fill in locally. Never commit real values.
# The leader (@ANaceri26/claude) owns this file; ask on the board to add a variable.

# --- Backend (app/backend) ---
API_HOST=127.0.0.1
API_PORT=8000
# Vite dev server origin allowed during development
FRONTEND_DEV_ORIGIN=http://localhost:5173

# --- Mission transport ---
# simulator = no hardware (labelled SIMULATED CONTROLLER); fpga = real DE10-Lite via XIAO
TRANSPORT_MODE=simulator
# XIAO USB serial port (Windows: COM5 etc., check Device Manager)
SERIAL_PORT=
SERIAL_BAUD=115200
# true = every flight has one automatic blackout (25 % to 85 % of the flight); false = only by button
AUTO_BLACKOUT=true
# true = add the demo communication delay (light time / 300, clamped 0.1-3.0 s one way)
LINK_DELAY_DEMO=false

# --- NASA data (Horizons + EONET need no API key) ---
# User-Agent sent to NASA APIs: app name/version + a team contact
NASA_USER_AGENT=Interstellar-HackTheNest/0.1
# Optional, only if an api.nasa.gov endpoint is added later
NASA_API_KEY=

# --- Brain extension (off by default; core must run without it) ---
BRAIN_ENABLED=false
BRAIN_PORT=8766
