{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interstellar.local/contracts/v1/common.schema.json",
  "title": "Shared definitions (contracts v1)",
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$", "description": "UTC timestamp, ISO 8601 with Z" },
    "u32": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "u16": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "body_id": { "type": "string", "enum": ["199", "299", "399", "499", "599", "699", "799", "899"], "description": "Horizons body id: 199 Mercury, 299 Venus, 399 Earth, 499 Mars, 599 Jupiter, 699 Saturn, 799 Uranus, 899 Neptune" },
    "target_id": { "type": "string", "enum": ["planet.399", "planet.499", "planet.more_details", "navigation.back"] },
    "data_mode": { "type": "string", "enum": ["nasa_live", "nasa_cached", "static_dataset", "synthetic"],
                   "description": "Where the numbers came from. synthetic = made-up test data; the UI must show a persistent banner." },
    "frame": {
      "type": "object",
      "required": ["center", "ref_system", "ref_plane", "units", "time_scale"],
      "properties": {
        "center": { "const": "500@10" },
        "ref_system": { "const": "ICRF" },
        "ref_plane": { "const": "ECLIPTIC" },
        "units": { "const": "KM-S" },
        "time_scale": { "const": "TDB" }
      }
    },
    "state_vector": {
      "type": "object",
      "required": ["jd_tdb", "r_km", "v_km_s"],
      "properties": {
        "jd_tdb": { "type": "number" },
        "r_km": { "$ref": "#/$defs/vec3" },
        "v_km_s": { "$ref": "#/$defs/vec3" }
      }
    },
    "source": {
      "type": "object",
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "retrieved_utc": { "anyOf": [{ "$ref": "#/$defs/utc" }, { "type": "null" }] },
        "sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "api_signature": { "type": ["string", "null"] }
      }
    }
  }
}
