{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interstellar.local/contracts/v1/intent_result.schema.json",
  "title": "IntentResult",
  "description": "Backend answer to a SelectionIntent.",
  "type": "object",
  "required": ["event_id", "accepted", "reason", "new_context_revision"],
  "additionalProperties": false,
  "properties": {
    "event_id": { "type": ["string", "null"] },
    "accepted": { "type": "boolean" },
    "reason": {
      "enum": ["accepted", "invalid_schema", "inactive_session", "source_mismatch", "stale_context", "expired_context",
               "revision_consumed", "duplicate_event_conflict", "invalid_target", "action_unavailable", "invalid_quality",
               "stale_heartbeat", "input_disabled"],
      "description": "accepted: applied (an exact retry of an accepted event returns accepted again). duplicate_event_conflict: same event_id, different content. revision_consumed: another intent already used this revision."
    },
    "new_context_revision": { "type": "integer", "minimum": 0, "description": "Authoritative revision after handling this intent" }
  }
}
