#!/usr/bin/env bash
# Keeps one agent "always on": waits for a board post that tags this folder's agent, then
# wakes the agent with that post as its prompt, and repeats.
#
# Usage (Git Bash, inside the agent's own working folder, after `tools/board iam <agent>`):
#   tools/agent-loop codex        # runs: codex exec resume --last "<prompt>"
#   tools/agent-loop claude       # runs: claude -p --continue "<prompt>"
# Stop with Ctrl+C.
#
# Env:
#   AGENT_ARGS      extra flags for the agent CLI, e.g. AGENT_ARGS="--sandbox workspace-write"
#   AGENT_COOLDOWN  minimum seconds between two wake-ups (default 60)
#   AGENT_LOOP_DRY  1 = print the command instead of running it
#
# The agent runs unattended, so it stops at the first approval prompt: allow its usual
# commands (git, gh, tools/board, tests) in that CLI's own settings first.
# This script never pulls or merges. It only runs `git fetch`; the agent rebases itself at
# the start of a task, as AGENTS.md section 3 says.
set -u

agent="${1:-}"
case "$agent" in
  codex|claude) ;;
  *) echo "usage: tools/agent-loop <codex|claude>" >&2; exit 2 ;;
esac
command -v "$agent" >/dev/null 2>&1 || { echo "agent-loop: '$agent' CLI not found on PATH" >&2; exit 1; }

ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1
handle="$(tools/board whoami)" || exit 1
case "$handle" in
  */"$agent") ;;
  *) echo "agent-loop: this folder is '$handle'. Run: tools/board iam $agent" >&2; exit 1 ;;
esac

# One loop per folder: two would wake the same agent twice.
lock="$ROOT/.board/agent-loop.lock"
if ! mkdir "$lock" 2>/dev/null; then
  echo "agent-loop: already running in this folder (delete $lock if that is wrong)" >&2
  exit 1
fi
trap 'rmdir "$lock" 2>/dev/null' EXIT
trap 'exit 130' INT TERM

cooldown="${AGENT_COOLDOWN:-60}"
# shellcheck disable=SC2206
extra=(${AGENT_ARGS:-})

echo "agent-loop: $handle is waiting for board posts that tag it. Ctrl+C to stop."
while :; do
  posts="$(tools/board wait --mentions-only)" || { sleep 30; continue; }
  git fetch -q origin 2>/dev/null || true

  prompt="New posts on the team board tag you (@$handle). They are below.
Follow AGENTS.md. Act on what is addressed to you and continue your current task.
Post on the board only when you have something to report (a blocker, a contract question,
a finished PR). Do not reply just to acknowledge. Do not merge anything.
If a post does not need any action from you, do nothing and stop.

$posts"

  echo "agent-loop: $(date '+%H:%M:%S') waking $agent"
  if [ "$agent" = codex ]; then
    cmd=(codex exec "${extra[@]}" resume --last "$prompt")
  else
    cmd=(claude -p --continue "${extra[@]}" "$prompt")
  fi
  if [ "${AGENT_LOOP_DRY:-0}" = 1 ]; then
    printf 'DRY RUN: %q ' "${cmd[@]:0:${#cmd[@]}-1}"; echo '"<prompt>"'
    echo "$prompt"
  else
    "${cmd[@]}" || echo "agent-loop: $agent exited with an error; still watching" >&2
  fi
  sleep "$cooldown"
done
